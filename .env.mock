# LIS White-Label System - Environment Configuration
# Self-contained version - no external Supabase dependency
# Copy this file to .env and adjust as needed

# ===========================================
# REQUIRED: Tenant Configuration
# ===========================================

# Default tenant ID (must match a YAML file in clients/)
TENANT=demo

# ===========================================
# REQUIRED: Database Configuration (Local PostgreSQL)
# ===========================================

# For Docker Compose (uses postgres service)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/lis_dev

# For local development outside Docker
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lis_dev

# ===========================================
# OPTIONAL: API Configuration
# ===========================================

# API URL for Streamlit to connect to backend
# In docker-compose, use service name (http://backend:8000)
# For local development, use http://localhost:8000
API_URL=http://backend:8000

# ===========================================
# OPTIONAL: Payment Processing
# ===========================================

# Stripe API key (optional, only if using billing)
STRIPE_KEY=sk_test_your_stripe_key_here

# ===========================================
# OPTIONAL: Development Settings
# ===========================================

# Enable debug mode (true/false)
DEBUG=true

# Redis URL for caching
REDIS_URL=redis://redis:6379

# ===========================================
# OPTIONAL: Local Database Credentials
# ===========================================

# These are for the local PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lis_dev

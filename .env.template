# LIS White-Label System - Environment Configuration
# Supabase version - connect to your Supabase project
# Copy this file to .env and adjust as needed

# ===========================================
# REQUIRED: Tenant Configuration
# ===========================================

# Default tenant ID (must match a YAML file in clients/)
TENANT=demo

# ===========================================
# REQUIRED: Supabase Configuration
# ===========================================

# Supabase project URL (found in your Supabase project settings)
SUPABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_ID].supabase.co:5432/postgres

# Supabase anonymous key for client-side operations
SUPABASE_KEY=your_supabase_anon_key_here

# ===========================================
# OPTIONAL: API Configuration
# ===========================================

# API URL for Streamlit to connect to backend
# In docker-compose, use service name (http://backend:8000)
# For local development, use http://localhost:8000
API_URL=http://backend:8000

# ===========================================
# OPTIONAL: Payment Processing
# ===========================================

# Stripe API key (optional, only if using billing)
STRIPE_KEY=sk_test_your_stripe_key_here

# ===========================================
# OPTIONAL: Development Settings
# ===========================================

# Enable debug mode (true/false)
DEBUG=true

# Redis URL for caching (optional, if using Supabase Redis or external Redis)
# REDIS_URL=redis://your-redis-url:6379

# ===========================================
# OPTIONAL: Fallback Local Database (for development)
# ===========================================

# Fallback database URL if Supabase is not available
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lis_dev
